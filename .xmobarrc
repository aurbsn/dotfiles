Config { font = "xft:terminus:size=12:antialias=false"
       , bgColor = "#272822"
       , fgColor = "#F8F8F2"
       , position = Top
       , lowerOnStart = True
       , commands = [ Run Cpu ["-L","3","-H","50","--normal", "#859900","--high","#b58900"] 10
                    , Run Memory ["-t","Mem: <usedratio>%"] 10
                    , Run Com "uname" ["-s","-r"] "" 36000
                    , Run Date "%a %b %_d %Y %H:%M:%S" "date" 10]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "%cpu% | %memory% }{ <fc=#268bd2>%date%</fc>"
       }
