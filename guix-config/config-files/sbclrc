(require :asdf)

(setf asdf:*central-registry*
      (list* '("/home/arbn/.guix-home/profile/share/common-lisp/systems/")))

(let ((guix-lib-dir (merge-pathnames "/home/your_username/.guix-profile/lib/"
                                     (user-homedir-pathname))))
